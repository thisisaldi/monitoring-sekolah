# Local: the pglite-server started per README.md
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# Only for local pglite-server (cannot interleave connections). Unset in production.
DB_POOL_MAX=1

# Production (Vercel): Supabase transaction pooler string, port 6543
# DATABASE_URL=postgresql://postgres.<ref>:<password>@<host>.pooler.supabase.com:6543/postgres
