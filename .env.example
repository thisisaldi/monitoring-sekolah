# Django
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=school_monitoring
POSTGRES_USER=school_monitoring
POSTGRES_PASSWORD=change-me

# Full connection string consumed by Django (host must match the
# docker-compose service name when running via Docker: "db")
DATABASE_URL=postgresql://school_monitoring:change-me@db:5432/school_monitoring
